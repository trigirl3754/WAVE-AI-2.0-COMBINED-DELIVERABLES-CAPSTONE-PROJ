{
  "name": "wave-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WAVE AI compliance dashboard — React frontend with a zero-dependency Node API",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
